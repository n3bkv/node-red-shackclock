[
  {
    "id": "weewx_mqtt_tab",
    "type": "tab",
    "label": "Example - WeeWX MQTT",
    "disabled": true,
    "info": "Enable and configure the MQTT broker after import. This example normalizes a whole-loop JSON message and caches it in global.stationWeather."
  },
  {
    "id": "weewx_broker",
    "type": "mqtt-broker",
    "name": "YOUR MQTT BROKER",
    "broker": "10.0.0.10",
    "port": "1883",
    "clientid": "shackclock",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {}
  },
  {
    "id": "weewx_mqtt_in",
    "type": "mqtt in",
    "z": "weewx_mqtt_tab",
    "name": "WeeWX loop JSON",
    "topic": "weather/loop",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "weewx_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 120,
    "wires": [
      [
        "weewx_json"
      ]
    ]
  },
  {
    "id": "weewx_json",
    "type": "json",
    "z": "weewx_mqtt_tab",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 390,
    "y": 120,
    "wires": [
      [
        "weewx_normalize"
      ]
    ]
  },
  {
    "id": "weewx_normalize",
    "type": "function",
    "z": "weewx_mqtt_tab",
    "name": "Normalize + cache",
    "func": "const p = msg.payload || {};\nconst out = {\n  outTemp: p.outTemp ?? p.temperature ?? p.temp_f,\n  heatindex: p.heatindex ?? p.heatIndex ?? p.feels_like,\n  outHumidity: p.outHumidity ?? p.humidity,\n  dewpoint: p.dewpoint ?? p.dewPoint ?? p.dew_point,\n  windSpeed: p.windSpeed ?? p.wind_mph,\n  windDir: p.windDir ?? p.wind_dir,\n  dayRain: p.dayRain ?? p.rainToday ?? p.rain,\n  receivedAt: Date.now()\n};\nglobal.set('stationWeather', out);\nmsg.payload = out;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 120,
    "wires": [
      [
        "weewx_debug"
      ]
    ]
  },
  {
    "id": "weewx_debug",
    "type": "debug",
