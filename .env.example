# Docker host port for the ShackClock web UI.
# This is a deployment-time setting read by Docker Compose.
# Change it in .env, then recreate the container with: docker compose up -d
SHACKCLOCK_PORT=4040

# Docker named volume used for persistent settings and caches.
SHACKCLOCK_DATA_VOLUME=shackclock-data

TZ=America/Los_Angeles
STATION_CALL=Your Call
STATION_NAME=Your Call ShackClock
STATION_LAT=Your LAT
STATION_LON=Your Lon
STATION_ELEV_M=Your Elevation

# Optional local-station override. If blank, OpenWeather current conditions are used.
WEEWX_JSON_URL=

# Optional. Must return GeoJSON FeatureCollection with Point features.
LIGHTNING_GEOJSON_URL=

# Recommended. Used for current conditions when WeeWX is not configured, and
# for the selectable cloud tile layer. The key stays server-side in Node-RED.
OPENWEATHER_API_KEY=

# Additional map layers
EARTHQUAKE_MIN_MAG=2.5
EARTHQUAKE_MAX_AGE_HOURS=24
AIR_TRAFFIC_ENABLED=true
# worldwide = one OpenSky global snapshot; nearby = ADSB.lol/ADSB.fi around QTH; local = your aircraft.json
AIR_TRAFFIC_MODE=worldwide
# Optional local readsb/dump1090 aircraft.json used when AIR_TRAFFIC_MODE=local.
AIR_TRAFFIC_JSON_URL=
AIR_TRAFFIC_RADIUS_NM=150
# 900 seconds is recommended for anonymous worldwide OpenSky use.
AIR_TRAFFIC_REFRESH_SEC=900
# Optional OpenSky OAuth credentials. Anonymous worldwide access works at 15-minute refresh; credentials provide much more quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Carrier activity uses the latest public USNI Fleet Tracker by default.
# Set a custom coarse/delayed GeoJSON URL to override the built-in source.
CARRIER_ENABLED=true
CARRIER_GEOJSON_URL=
CARRIER_REFRESH_HOURS=6
CARRIER_MAX_AGE_HOURS=336

# Bootstrap defaults only. After first start, edit these in the web Settings page.
# W3LPL AR-Cluster v6
DX_CLUSTER_ENABLED=true
DX_CLUSTER_HOST=w3lpl.net
DX_CLUSTER_PORT=7373
DX_CLUSTER_CALL=Your Call
DX_CLUSTER_MAX_AGE_MIN=20
POTA_SPOTS_URL=https://api.pota.app/spot/activator
PSKREPORTER_SECONDS=-3600
PSKREPORTER_LIMIT=100
# ISS orbital-elements source. Default uses WhereTheISS.at and is cached by the local tracker.
ISS_TLE_URL=https://api.wheretheiss.at/v1/satellites/25544/tles?format=text

# Optional city clocks shown along the bottom of the display.
# Use IANA timezone names such as Europe/London or Asia/Tokyo.
CITY1_LABEL=Tokyo
CITY1_TZ=Asia/Tokyo
CITY2_LABEL=Sydney
CITY2_TZ=Australia/Sydney
CITY3_LABEL=London
CITY3_TZ=Europe/London
CITY4_LABEL=New York
CITY4_TZ=America/New_York
CITY5_LABEL=Denver
CITY5_TZ=America/Denver
CITY6_LABEL=Chicago
CITY6_TZ=America/Chicago
CITY7_LABEL=
CITY7_TZ=
CITY8_LABEL=
CITY8_TZ=


# Amateur satellites shown on the map must have a positive AMSAT status report
# (Heard or Crew Active) within this rolling window.
AMSAT_ACTIVE_HOURS=24
